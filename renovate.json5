{
  // Renovate configuration for domarinn.
  //
  // This is deliberately self-contained. It used to be one line extending a
  // private org preset (`local>AtvikSecurity/renovate-config`), which no fork
  // and no outside contributor can resolve — so it is inlined here instead.
  // The behaviour below is the same policy, with one intentional divergence
  // documented under "Commit types" that exists to keep Renovate from cutting
  // releases. Written as JSON5 because the reasoning matters more than the
  // brevity.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    // Container base images should offer major bumps too; the Dockerfile pins
    // node/rust/debian tags that would otherwise go stale forever.
    "docker:enableMajor",
    // Actions are pinned to commit SHAs (see the workflows); this keeps the
    // trailing `# vX.Y.Z` comment accurate when the SHA moves.
    "helpers:pinGitHubActionDigestsToSemver",
    // Branch-based automerge: Renovate runs the update on a temporary branch
    // and, once checks pass, pushes straight to the base branch. It does not
    // use GitHub's native auto-merge, so it needs no "Allow auto-merge"
    // setting and no branch-protection rule — but it does require the default
    // branch to permit direct pushes by the Renovate app.
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
  ],

  dependencyDashboardTitle: "Renovate Dashboard 🤖",

  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    // Covered by the blanket automerge policy below; set here too because
    // lockFileMaintenance reads its own config object rather than inheriting
    // from a packageRules match.
    automerge: true,
  },

  // Track plain version strings marked with an inline `# renovate:` annotation,
  // e.g. the pinned OPENSSL_VER / LIBXML2_VER / XMLSEC_VER ARGs in the
  // Dockerfile:
  //   # renovate: datasource=github-releases depName=foo/bar
  //   FOOBAR_VERSION=v1.0.0
  customManagers: [
    {
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: ["/\\.env(?:\\.j2)?$/", "/\\.sh(?:\\.j2)?$/", "/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
  ],

  packageRules: [
    // --- Commit types -----------------------------------------------------
    //
    // IMPORTANT: none of these may produce `feat`, `fix`, or a `!` breaking
    // marker. release-please parses the commits on `main` to decide the next
    // version, and it treats `!` as breaking regardless of the type. The org
    // preset this file replaces mapped major bumps to `feat(deps)!:`, which
    // would have made every major dependency bump cut a release — git history
    // shows 15 `feat(deps)!` and 10 `ci(github-action)!` commits that each
    // would have done so.
    //
    // Dependency bumps therefore ride along in the next human-authored
    // release. To ship one urgently (a CVE, say), land a hand-written
    // `fix(deps): ...` commit or run the Release Please workflow manually.
    {
      description: "Dependency updates never drive a release version bump",
      matchUpdateTypes: ["major", "minor", "patch", "digest", "pin", "lockFileMaintenance"],
      semanticCommitType: "chore",
    },
    {
      matchUpdateTypes: ["major"],
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["minor", "patch"],
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["digest"],
      commitMessageExtra: "({{currentDigestShort}} → {{newDigestShort}})",
    },

    // --- Scopes -----------------------------------------------------------
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      // `ci` is a non-releasing type in release-please's changelog config.
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitType: "chore",
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitType: "chore",
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
    },

    // --- Labels -----------------------------------------------------------
    { matchUpdateTypes: ["major"], labels: ["type/major"] },
    { matchUpdateTypes: ["minor"], labels: ["type/minor"] },
    { matchUpdateTypes: ["patch"], labels: ["type/patch"] },
    { matchUpdateTypes: ["digest"], labels: ["type/digest"] },

    // --- Automerge --------------------------------------------------------
    //
    // Policy: automerge everything, in every manager, at every update type —
    // gated only on CI going green. This replaces the previous arrangement,
    // where only patch/digest bumps and GitHub Actions automerged and
    // everything else waited for a human.
    //
    // Two things make that safe enough to be worth it:
    //
    //   1. CI is the gate. `:automergeBranch` (see extends) runs the update on
    //      a temporary branch, waits for that branch's checks, and only then
    //      fast-forwards the base branch. If anything fails, Renovate opens a
    //      normal PR instead and it sits there for a human — a red update can
    //      never land. Note this means `ignoreTests` must stay off everywhere;
    //      the old GitHub Actions rules set it to true, which skipped checks
    //      entirely, and that is exactly what this policy must not do.
    //
    //   2. The soak below. A malicious or broken publish is usually yanked
    //      within hours, so waiting keeps the worst of it out of the tree.
    //
    // The soak ALSO has to stay >= pnpm's own `minimumReleaseAge`, which is
    // enforced at install time and defaults to ~1 day in pnpm 11. When
    // Renovate is the faster of the two it opens npm PRs whose lockfile pnpm
    // then refuses, and CI fails with ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION
    // rather than anything to do with the code (this happened to the
    // jsdom 30.0.0 PR). 3 days clears the 1-day floor with room to spare.
    {
      description: "Automerge everything that passes CI, after a 3-day soak",
      matchUpdateTypes: ["major", "minor", "patch", "digest", "pin", "lockFileMaintenance"],
      automerge: true,
      minimumReleaseAge: "3 days",
    },

    // --- Version constraints ----------------------------------------------
    //
    // typescript-eslint throws at module load on TypeScript 7 — its peer range
    // is `typescript >=4.8.4 <6.1.0`, and TS 7 support is tracked upstream for
    // TS >=7.1 in typescript-eslint/typescript-eslint#10940. So the plain
    // `typescript` dep, which is the one the linter resolves, is capped below
    // 6.1 on purpose. Without this cap Renovate would keep proposing 7.x for
    // it, the web lint job would keep failing, and — under the automerge
    // policy above — the update would never land and simply accumulate as
    // noise.
    //
    // The compiler is NOT capped: web/package.json aliases `typescript-7` to
    // the real TypeScript 7 and type-checks with that, so `tsc -b` tracks
    // latest normally. See the `//typescript` key there for the unwind.
    // Lift this cap when typescript-eslint ships TS 7 support.
    {
      description: "Hold `typescript` below 6.1 while typescript-eslint rejects TS 7",
      matchManagers: ["npm"],
      matchDepNames: ["typescript"],
      allowedVersions: "<6.1.0",
    },
    {
      // Belt and braces. For an aliased dep (`"typescript-7":
      // "npm:typescript@^7.0.2"`) Renovate keys depName off the alias and
      // resolves packageName to the real package — so the cap above should not
      // reach this one. Restating the bound here means that even if the match
      // above were to catch the alias, the compiler still tracks 7.x rather
      // than silently freezing at 7.0.2. This rule comes second on purpose:
      // later packageRules win.
      description: "The aliased TS 7 compiler tracks latest 7.x",
      matchManagers: ["npm"],
      matchDepNames: ["typescript-7"],
      allowedVersions: "<8.0.0",
    },

    // --- Manager quirks ---------------------------------------------------
    {
      description: "Bump the manifest range (package.json), not just the lockfile, so both update together. npm's default rangeStrategy ('replace') leaves a caret range untouched when the new version still satisfies it, so in-range minor/patch updates would otherwise only change the lockfile.",
      matchManagers: ["npm"],
      rangeStrategy: "bump",
    },
  ],
}
