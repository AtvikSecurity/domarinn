{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    // exactOptionalPropertyTypes intentionally omitted: with the generated-type
    // policy it buys no runtime safety and forces pervasive `| undefined` churn.

    // "node" is here only for the colocated `*.test.ts` files that read project
    // source off disk (e.g. lib/contrast.test.ts parses index.css, since vitest
    // stubs CSS imports). App code must not use node APIs; eslint gives browser
    // globals to `src/**` and node globals only to test files.
    "types": ["vite/client", "vitest/globals", "node"],

    // No `baseUrl`: it is deprecated in TS 6 (a hard error without
    // `ignoreDeprecations`) and removed in TS 7. It is not needed here -- the
    // `paths` entries below are relative (`./src/*`), so they resolve against
    // this file's directory on their own. Do not re-add it.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
