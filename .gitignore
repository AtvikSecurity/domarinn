/target
**/*.rs.bk
.domarinn/
# Node / web build artifacts (added when the UI lands)
node_modules/
web/dist/
!web/dist/index.html
# TypeScript incremental build info (regenerated by `tsc -b`; not source)
*.tsbuildinfo
# Local editor / OS noise
.DS_Store
.superpowers/
.claude/

# Runtime data dir created by `domarinn server` / docker-compose
data/

# Built documentation site (`mise run docs`). Published from CI as a Pages
# artifact, never committed.
site/

# The venv `uv run` materializes the uv.lock-pinned MkDocs toolchain into.
# Reproducible from pyproject.toml + uv.lock, so it is a build artifact.
.venv/

# mise local overrides (per-developer env, e.g. smoke-test endpoints)
.mise/config.local.toml
mise.local.toml

# Core dumps (e.g. from a crashed test/build)
core.*
core

# Playwright MCP session artifacts
.playwright-mcp/

# Docs-screenshot pipeline: the saved login session (a real bearer token),
# never the captured PNGs — those under docs/assets/screenshots/ are committed.
web/screenshots/.auth/
