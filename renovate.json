{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>AtvikSecurity/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Auto-merge patch + digest updates after a 3-day soak",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    }
  ]
}
