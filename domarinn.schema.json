    "VerdictMode": {
      "description": "How an `llm-rubric` grader's structured verdict is obtained. `Forced` is\nthe default; `Auto` is documented but currently unread by the grader.",
      "type": "string",
      "enum": [
        "forced",
        "auto"
      ]
    },
    "TokenCount": {
      "description": "Which tokens a `tokens` assertion counts.",
      "oneOf": [
        {
          "description": "Input plus output. The default, and what every existing suite means.",
          "type": "string",
          "const": "total"
        },
        {
          "description": "Everything the provider bills for, cache reads and writes included. On a\ncache-heavy workload this can be several times `total`.",
          "type": "string",
          "const": "billable"
        }
      ]
    },
    "Defaults": {
      "description": "Values merged into every test before it runs.",
      "type": "object",
      "properties": {
        "vars": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Val"
          },
          "default": {}
        },
        "assert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assert"
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_salt": {
          "description": "Suite-wide fallback for [`TestCase::cache_salt`], used only by cases that\ndo not set their own. A *constant* value here busts the whole suite on\nevery change — it is a fallback, not the granularity mechanism. Note it\ndoes not reach generator-produced cases (they are appended after the\ndefaults merge).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Runner": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "retries": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryCfg"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/RateLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "short_circuit": {
          "description": "Whether deterministic asserts short-circuit the grader. Default true.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RetryCfg": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "initial_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "jitter": {
          "description": "Spread concurrent retries so rate-limited cells do not all wake at once.",
          "type": "boolean",
          "default": false
        },
        "retry_after_max_ms": {
          "description": "Largest server-supplied `Retry-After` to honor, in milliseconds\n(default 120000).\n\nSeparate from `max_ms` on purpose: `max_ms` caps domarinn's own\nexponential growth, whereas `Retry-After` is a directive describing the\nserver's rate window. A hint above this ceiling errors the case rather\nthan retrying early, which would only earn another 429.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max"
      ]
    },
    "RateLimit": {
      "type": "object",
      "properties": {
        "rps": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "rps"
      ]
    },
    "CacheCfg": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/CacheBackendKind",
          "default": "disk"
        },
        "s3": {
          "anyOf": [
            {
              "$ref": "#/$defs/S3Cfg"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CacheBackendKind": {
      "type": "string",
      "enum": [
        "disk",
        "layered",
        "http",
        "s3"
      ]
    },
    "S3Cfg": {
      "description": "Non-secret S3 settings; credentials come from the environment / AWS chain.",
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "force_path_style": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "bucket"
      ]
    }
  }
