{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AtvikSecurity/domarinn/main/domarinn.schema.json",
  "title": "Suite",
  "description": "The top-level eval suite.",
  "type": "object",
  "properties": {
    "version": {
      "description": "Config schema version. Currently always `1`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "project": {
      "description": "Project namespace (groups runs on the server).",
      "type": [
        "string",
        "null"
      ]
    },
    "suite": {
      "description": "Suite name (names the run's suite).",
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "extends": {
      "description": "A base suite to deep-merge on top of (composition).",
      "type": [
        "string",
        "null"
      ]
    },
    "imports": {
      "description": "Reusable fragments (named assert-sets, shared providers) to import.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "providers": {
      "description": "The systems under test. At least one is required.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Provider"
      }
    },
    "prompts": {
      "description": "Optional prompts. Omit when a provider constructs its own input.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Prompt"
      }
    },
    "tests": {
      "description": "Test sources: inline cases, `file://` globs, or generator commands.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestSource"
      },
      "default": []
    },
    "defaults": {
      "description": "Values merged into every test.",
      "anyOf": [
        {
          "$ref": "#/$defs/Defaults"
        },
        {
          "type": "null"
        }
      ]
    },
    "grader": {
      "description": "Default grader for `llm-rubric` assertions.",
      "anyOf": [
        {
          "$ref": "#/$defs/Grader"
        },
        {
          "type": "null"
        }
      ]
    },
    "runner": {
      "anyOf": [
        {
          "$ref": "#/$defs/Runner"
        },
        {
          "type": "null"
        }
      ]
    },
    "cache": {
      "anyOf": [
        {
          "$ref": "#/$defs/CacheCfg"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "providers"
  ],
  "$defs": {
    "Provider": {
      "description": "A system under test.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "description": "Spawn an external command speaking the exec JSON protocol.",
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "timeout_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "cache_salt": {
              "description": "Cache-busting token (e.g. a git SHA or binary hash). Without it, exec\nproviders default to no-cache so a rebuilt binary is never stale.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "exec"
            }
          },
          "required": [
            "type",
            "command"
          ]
        },
        {
          "description": "Native Anthropic Messages API client.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_key_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "pricing": {
              "description": "Rate override for this provider's model. See [`PricingCfg`].\n\nBoxed because `ProviderKind` is reachable from `AssertKind` (an\n`llm-rubric` can carry its own grader, which carries a provider), so\nfive inline `Option<f64>` here would inflate every assertion in\nevery suite by 80 bytes. Transparent to serde and schemars — the\nYAML is unchanged.",
              "anyOf": [
                {
                  "$ref": "#/$defs/PricingCfg"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "anthropic"
            }
          },
          "required": [
            "type",
            "model"
          ]
        },
        {
          "description": "OpenAI-compatible chat-completions client.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_key_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "pricing": {
              "description": "Rate override for this provider's model. See [`PricingCfg`].\n\nBoxed because `ProviderKind` is reachable from `AssertKind` (an\n`llm-rubric` can carry its own grader, which carries a provider), so\nfive inline `Option<f64>` here would inflate every assertion in\nevery suite by 80 bytes. Transparent to serde and schemars — the\nYAML is unchanged.",
              "anyOf": [
                {
                  "$ref": "#/$defs/PricingCfg"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "openai"
            }
          },
          "required": [
            "type",
            "model"
          ]
        },
        {
          "description": "Arbitrary HTTP endpoint.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "method": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HttpMethod"
                },
                {
                  "type": "null"
                }
              ]
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": true,
            "output_expr": {
              "description": "minijinja expression selecting the output from the response.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "http"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "description": "Embeddings endpoint used by the `similar` assertion.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_key_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "embeddings"
            }
          },
          "required": [
            "type",
            "model"
          ]
        }
      ]
    },
    "PricingCfg": {
      "description": "A per-provider rate override, in USD per million tokens.\n\nMerged field-wise over the built-in rate for the provider's model, so a\nsuite can correct one stale number without restating a whole price sheet.\nExists for the cases a shipped table cannot cover: a proxy or gateway with\nnegotiated rates, a fine-tune, or a model the table has never heard of.\n\n`f64` is right *here* and nowhere else — a human writes `3.00` in YAML, and\nit converts to integer micro-dollars once when the provider is built.\n\nNever reaches a provider's `fingerprint()`, so setting it does not\ninvalidate a single cache entry: cost is not request identity.",
      "type": "object",
      "properties": {
        "input_per_mtok": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "output_per_mtok": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_read_per_mtok": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_write_per_mtok": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_write_1h_per_mtok": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "HttpMethod": {
      "description": "The HTTP method for a `type: http` provider. Authors may write either case\n(`get` or `GET`) in YAML; the wire method (and the request/cache\nfingerprint) is always the uppercase form.",
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD"
      ]
    },
    "Prompt": {
      "description": "A prompt template. Exactly one of `template` / `messages` must be set.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "messages": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Message"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Message": {
      "description": "A chat message; `content` may be `file://path` to load from disk.",
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/ChatRole"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ]
    },
    "ChatRole": {
      "description": "A chat message role.",
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant"
      ]
    },
    "TestSource": {
      "description": "An entry in the `tests:` list.\n\n`Deserialize` is hand-written (rather than derived as `#[serde(untagged)]`)\nso a typo inside an inline test case surfaces the precise unknown-field\nerror from [`TestCase`]'s `deny_unknown_fields` instead of the opaque\n\"data did not match any variant of untagged enum\" an untagged derive emits.\n`Serialize`/`JsonSchema` keep the untagged shape (a glob string, a\n`{generator: ...}` mapping, or an inline case mapping).",
      "anyOf": [
        {
          "description": "A `file://glob` reference to YAML/JSON/CSV/JSONL test files.",
          "type": "string"
        },
        {
          "description": "A generator command that emits test cases as JSON.",
          "$ref": "#/$defs/GeneratorWrap"
        },
        {
          "description": "An inline test case.",
          "$ref": "#/$defs/TestCase"
        }
      ]
    },
    "GeneratorWrap": {
      "type": "object",
      "properties": {
        "generator": {
          "$ref": "#/$defs/GeneratorSpec"
        }
      },
      "additionalProperties": false,
      "required": [
        "generator"
      ]
    },
    "GeneratorSpec": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": true,
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "TestCase": {
      "description": "A single test case.",
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Val"
          }
        },
        "matrix": {
          "description": "Parameter sweep: each axis maps a var name to the list of values it takes.\nThe case fans out over the cartesian product of its axes (one case per\ncombination), with each axis value merged into `vars`. See\n[`crate::matrix`].",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Val"
            }
          }
        },
        "matrix_id": {
          "description": "Optional minijinja template for a matrix cell's id, rendered against the\naxis values (e.g. `\"{{ style }}-{{ temperature }}\"`). Defaults to\n`<base-id>[key=value,…]`.",
          "type": [
            "string",
            "null"
          ]
        },
        "assert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assert"
          }
        },
        "threshold": {
          "description": "If set, the case passes when its weighted-mean score >= threshold;\notherwise it passes only if every assert passes.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_salt": {
          "description": "Opaque per-case cache-busting token, folded into this case's provider\ncache key. Use it when the system under test loads content domarinn\ncannot see (its own prompt files), so editing that content busts only\nthe cases that use it. Never sent to the provider. It does not make a\nprovider cacheable on its own — an `exec` provider still needs its own\n`cache_salt` for that.\n\nUsed **verbatim**, and deliberately not templated: a useful salt is a\ndigest of something domarinn cannot see, so it could only be derived from\nthe environment — and `env` is deliberately kept out of the request\nidentity (see [`crate::render`]) so that unrelated environment drift\nnever busts a shared cache. Keeping it a literal also means it can never\nfail to render and is never a template-injection surface. Compute the\ndigest outside the suite and write the value in.",
          "type": [
            "string",
            "null"
          ]
        },
        "only_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Val": true,
    "Assert": {
      "description": "A single assertion with its common controls. `type: not-<kind>` is sugar for\n`negate: true` and works in every test source.",
      "type": "object",
      "properties": {
        "weight": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "negate": {
          "type": "boolean",
          "default": false
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "contains"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "icontains"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "icontains-any"
            }
          },
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "regex"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/Val"
            },
            "type": {
              "type": "string",
              "const": "equals"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "starts-with"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is-json"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Val"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "contains-json"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "length"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "jinja"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "config": true,
            "type": {
              "type": "string",
              "const": "exec"
            }
          },
          "required": [
            "type",
            "command"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "grader": {
              "description": "Boxed because it is by far the largest thing an assertion can carry\n(a whole `Grader`, including a `ProviderKind`), and every other\n`AssertKind` variant pays for it inline otherwise. Transparent to\nserde and schemars — the YAML is unchanged.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Grader"
                },
                {
                  "type": "null"
                }
              ]
            },
            "threshold": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "llm-rubric"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Total cost in USD must be <= max. Bypasses the cache.",
          "type": "object",
          "properties": {
            "max": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "cost"
            }
          },
          "required": [
            "type",
            "max"
          ]
        },
        {
          "description": "Latency in ms must be <= max. Bypasses the cache.",
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "latency"
            }
          },
          "required": [
            "type",
            "max"
          ]
        },
        {
          "description": "Token count must be <= max. See [`TokenCount`] for which tokens.",
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "count": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TokenCount"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "tokens"
            }
          },
          "required": [
            "type",
            "max"
          ]
        },
        {
          "description": "Embedding cosine similarity to a reference must be >= threshold.",
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/Val"
            },
            "threshold": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "similar"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "Grader": {
      "description": "The LLM grader for `llm-rubric`.",
      "type": "object",
      "properties": {
        "provider": {
          "description": "The grading model. Should be a different model family than the SUT.",
          "$ref": "#/$defs/ProviderKind"
        },
        "template": {
          "description": "Optional override of the built-in grading-prompt template (`file://`).",
          "type": [
            "string",
            "null"
          ]
        },
        "verdict_mode": {
          "description": "`forced` (default) or `auto` — how the structured verdict is obtained.",
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "description": "How long to wait for a verdict, in milliseconds. Defaults to 120s.\n\nReachable from config because the ceiling interacts with the grader's\nown `max_tokens`: a reasoning grader given room to think can take\nlonger than a fixed constant allows, and the failure looks like a\ntransport fault rather than a budget one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "provider"
      ]
    },
    "ProviderKind": {
      "description": "The behavior of a provider, selected by `type`.",
      "oneOf": [
        {
          "description": "Spawn an external command speaking the exec JSON protocol.",
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "timeout_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "cache_salt": {
              "description": "Cache-busting token (e.g. a git SHA or binary hash). Without it, exec\nproviders default to no-cache so a rebuilt binary is never stale.",
