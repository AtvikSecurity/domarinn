        "layered",
        "http",
        "s3"
      ]
    },
    "S3Cfg": {
      "description": "Non-secret S3 settings; credentials come from the environment / AWS chain.",
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": [
