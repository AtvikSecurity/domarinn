{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suite",
  "description": "The top-level eval suite.",
  "type": "object",
  "properties": {
    "version": {
      "description": "Config schema version. Currently always `1`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "project": {
      "description": "Project namespace (groups runs on the server).",
      "type": [
        "string",
        "null"
      ]
    },
    "suite": {
      "description": "Suite name (names the run's suite).",
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "extends": {
      "description": "A base suite to deep-merge on top of (composition).",
      "type": [
        "string",
        "null"
      ]
    },
    "imports": {
      "description": "Reusable fragments (named assert-sets, shared providers) to import.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "providers": {
      "description": "The systems under test. At least one is required.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Provider"
      }
    },
    "prompts": {
      "description": "Optional prompts. Omit when a provider constructs its own input.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Prompt"
      }
    },
    "tests": {
      "description": "Test sources: inline cases, `file://` globs, or generator commands.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestSource"
      },
      "default": []
    },
    "defaults": {
      "description": "Values merged into every test.",
      "anyOf": [
        {
          "$ref": "#/$defs/Defaults"
        },
        {
          "type": "null"
        }
      ]
    },
    "grader": {
      "description": "Default grader for `llm-rubric` assertions.",
      "anyOf": [
        {
          "$ref": "#/$defs/Grader"
        },
        {
          "type": "null"
        }
      ]
    },
    "runner": {
      "anyOf": [
        {
          "$ref": "#/$defs/Runner"
        },
        {
          "type": "null"
        }
      ]
    },
    "cache": {
      "anyOf": [
        {
          "$ref": "#/$defs/CacheCfg"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "providers"
  ],
  "$defs": {
    "Provider": {
      "description": "A system under test.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "description": "Spawn an external command speaking the exec JSON protocol.",
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "timeout_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "cache_salt": {
              "description": "Cache-busting token (e.g. a git SHA or binary hash). Without it, exec\nproviders default to no-cache so a rebuilt binary is never stale.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "exec"
            }
          },
          "required": [
            "type",
            "command"
          ]
        },
        {
          "description": "Native Anthropic Messages API client.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_key_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "anthropic"
            }
          },
          "required": [
            "type",
            "model"
          ]
        },
        {
          "description": "OpenAI-compatible chat-completions client.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_key_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "openai"
            }
          },
          "required": [
            "type",
            "model"
          ]
        },
        {
          "description": "Arbitrary HTTP endpoint.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "method": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HttpMethod"
                },
                {
                  "type": "null"
                }
              ]
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": true,
            "output_expr": {
              "description": "minijinja expression selecting the output from the response.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "http"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "description": "Embeddings endpoint used by the `similar` assertion.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_key_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "embeddings"
            }
          },
          "required": [
            "type",
            "model"
          ]
        }
      ]
    },
    "HttpMethod": {
      "description": "The HTTP method for a `type: http` provider. Authors may write either case\n(`get` or `GET`) in YAML; the wire method (and the request/cache\nfingerprint) is always the uppercase form.",
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD"
      ]
    },
    "Prompt": {
      "description": "A prompt template. Exactly one of `template` / `messages` must be set.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "messages": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Message"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Message": {
      "description": "A chat message; `content` may be `file://path` to load from disk.",
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/ChatRole"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ]
    },
    "ChatRole": {
      "description": "A chat message role.",
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant"
      ]
    },
    "TestSource": {
      "description": "An entry in the `tests:` list.\n\n`Deserialize` is hand-written (rather than derived as `#[serde(untagged)]`)\nso a typo inside an inline test case surfaces the precise unknown-field\nerror from [`TestCase`]'s `deny_unknown_fields` instead of the opaque\n\"data did not match any variant of untagged enum\" an untagged derive emits.\n`Serialize`/`JsonSchema` keep the untagged shape (a glob string, a\n`{generator: ...}` mapping, or an inline case mapping).",
      "anyOf": [
        {
          "description": "A `file://glob` reference to YAML/JSON/CSV/JSONL test files.",
          "type": "string"
        },
        {
          "description": "A generator command that emits test cases as JSON.",
          "$ref": "#/$defs/GeneratorWrap"
        },
        {
          "description": "An inline test case.",
          "$ref": "#/$defs/TestCase"
        }
      ]
    },
    "GeneratorWrap": {
      "type": "object",
      "properties": {
        "generator": {
          "$ref": "#/$defs/GeneratorSpec"
        }
      },
      "additionalProperties": false,
      "required": [
        "generator"
      ]
    },
    "GeneratorSpec": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": true,
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "TestCase": {
      "description": "A single test case.",
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Val"
          }
        },
        "assert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assert"
          }
        },
        "threshold": {
          "description": "If set, the case passes when its weighted-mean score >= threshold;\notherwise it passes only if every assert passes.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "only_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Val": true,
    "Assert": {
      "description": "A single assertion with its common controls.",
      "type": "object",
      "properties": {
        "weight": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "negate": {
          "type": "boolean",
          "default": false
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "contains"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "icontains"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "icontains-any"
            }
          },
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "regex"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/Val"
            },
            "type": {
              "type": "string",
              "const": "equals"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "starts-with"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is-json"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Val"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "contains-json"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "length"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "jinja"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "config": true,
            "type": {
              "type": "string",
              "const": "exec"
            }
          },
          "required": [
            "type",
            "command"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "grader": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Grader"
                },
                {
                  "type": "null"
                }
              ]
            },
            "threshold": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "llm-rubric"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Total cost in USD must be <= max. Bypasses the cache.",
          "type": "object",
          "properties": {
            "max": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "cost"
            }
          },
          "required": [
            "type",
            "max"
          ]
        },
        {
          "description": "Latency in ms must be <= max. Bypasses the cache.",
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "latency"
            }
          },
          "required": [
            "type",
            "max"
          ]
        },
        {
          "description": "Total tokens must be <= max.",
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "tokens"
            }
          },
          "required": [
            "type",
            "max"
          ]
        },
        {
          "description": "Embedding cosine similarity to a reference must be >= threshold.",
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/Val"
            },
            "threshold": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "similar"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "Grader": {
      "description": "The LLM grader for `llm-rubric`.",
      "type": "object",
      "properties": {
        "provider": {
          "description": "The grading model. Should be a different model family than the SUT.",
          "$ref": "#/$defs/ProviderKind"
        },
        "template": {
          "description": "Optional override of the built-in grading-prompt template (`file://`).",
          "type": [
            "string",
            "null"
          ]
        },
        "verdict_mode": {
          "description": "`forced` (default) or `auto` — how the structured verdict is obtained.",
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "provider"
      ]
    },
    "ProviderKind": {
      "description": "The behavior of a provider, selected by `type`.",
      "oneOf": [
        {
          "description": "Spawn an external command speaking the exec JSON protocol.",
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "timeout_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "cache_salt": {
              "description": "Cache-busting token (e.g. a git SHA or binary hash). Without it, exec\nproviders default to no-cache so a rebuilt binary is never stale.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "exec"
            }
          },
          "required": [
            "type",
            "command"
          ]
        },
        {
          "description": "Native Anthropic Messages API client.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_key_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "anthropic"
            }
          },
          "required": [
            "type",
            "model"
          ]
        },
        {
          "description": "OpenAI-compatible chat-completions client.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_key_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "openai"
            }
          },
          "required": [
            "type",
            "model"
          ]
        },
        {
          "description": "Arbitrary HTTP endpoint.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "method": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HttpMethod"
                },
                {
                  "type": "null"
                }
              ]
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": true,
            "output_expr": {
              "description": "minijinja expression selecting the output from the response.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "http"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "description": "Embeddings endpoint used by the `similar` assertion.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_key_env": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "embeddings"
            }
          },
          "required": [
            "type",
            "model"
          ]
        }
      ]
    },
    "VerdictMode": {
      "description": "How an `llm-rubric` grader's structured verdict is obtained. `Forced` is\nthe default; `Auto` is documented but currently unread by the grader.",
      "type": "string",
      "enum": [
        "forced",
        "auto"
      ]
    },
    "Defaults": {
      "description": "Values merged into every test before it runs.",
      "type": "object",
      "properties": {
        "vars": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Val"
          },
          "default": {}
        },
        "assert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assert"
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Runner": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "retries": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryCfg"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/RateLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "short_circuit": {
          "description": "Whether deterministic asserts short-circuit the grader. Default true.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RetryCfg": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "initial_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "jitter": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "max"
      ]
    },
    "RateLimit": {
      "type": "object",
      "properties": {
